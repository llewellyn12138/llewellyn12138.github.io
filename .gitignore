# IDE 配置
.idea/
.vs/
.vscode/

# VS Code 工作区配置
*.code-workspace

# Node.js 依赖
node_modules/
package-lock.json
!blog-source/package-lock.json

# Hexo 生成文件
blog-source/db.json
blog-source/public/

# 由 posts/ 自动同步生成的镜像，勿手改
blog-source/source/_posts/

# 构建产物（本地预览用，不提交）
dist/

# blog/ 是构建脚本镜像出来的 Hexo 输出（跟踪它，让源码树可离线打开，
# 也是当前 Pages 直接服务 main 分支时的兜底）

# 本地脚本
preview_blog.bat

# 日志文件
*.log

# 操作系统文件
.DS_Store
Thumbs.db
*.swp
*.swo

# 编辑器临时文件
*~
.#*